# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=expense_tracker
DB_SSLMODE=disable

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE_HOURS=24
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_REFRESH_EXPIRE_HOURS=168

# Server Configuration
SERVER_PORT=8080
SERVER_MODE=debug
# Comma separated list of allowed origins (required when SERVER_MODE=release)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Email Verification (OTP)
# Leave SMTP_HOST empty in debug mode to print emails to the server log.
# Local dev: run Mailpit (SMTP localhost:1025, UI http://localhost:8025) with SMTP_HOST=localhost SMTP_PORT=1025
# Production: any SMTP provider (e.g. Brevo, port 587 STARTTLS). Port 465 (implicit TLS) is not supported.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
EMAIL_OTP_EXPIRE_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_RESEND_COOLDOWN_SECONDS=60
EMAIL_RESEND_MAX_PER_DAY=5
# Unverified accounts older than this are deleted periodically
UNVERIFIED_USER_TTL_HOURS=168

# Frontend base URL, prefixed to endpoints shown in response messages (e.g. https://app.example.com). Optional.
BASE_URL_FE=
